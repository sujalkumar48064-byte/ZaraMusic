# Copy to .env (VPS) or paste the whole thing into Voroa → Environment → "paste .env"
# ── Required ──
API_ID=
API_HASH=
BOT_TOKEN=
STRING_SESSION=
MONGO_DB_URL=
OWNER_ID=

# ── Download: cookies first, API fallback ──
USE_COOKIES=True        # True: cookies first, API fallback | False: API first
COOKIES_URL=            # batbin.me links, space separated
API_URL=                # optional, your download API
API_KEY=                # optional
INVIDIOUS_APIS=https://yt.chocolatemoo53.com   # free, no-key fallback (space/comma separated)
FREE_API_FALLBACK=True                          # free public API fallback when yt-dlp is blocked

# ── Optional ──
LOGGER_ID=
OWNER_USERNAME=duifioookn2
BOT_NAME=
BOT_LINK=
SUPPORT_GROUP=
UPDATES_CHANNEL=
PING_IMG_URL=
KEEP_ALIVE_URL=https://zaramusic.onrender.com
SESSION_NAME=ZaraMusic
# PORT is set automatically by Voroa / Render / Koyeb (default 10000)
